@MyCons = (h (t (* ((h (t call)) call))))

@MyNothing = (call (* call))

@MyJust = (x (* ((x call) call)))

@MyFalse = (call (* call))

@MyTrue = (* (call call))

@Leaf = (x ((x call) (* call)))

@Node = (l (r (* ((l (r call)) call))))

@mul = @prim_mul

@sub = @prim_sub

@add = @prim_add

@calc = (a (b (c top_ret_1)))
  & a ~ x
  & b ~ y
  & c ~ y1
  & x ~ $([+] $(y add_res_2))
  & add_res_2 ~ $([*] $(y1 mul_res_3))
  & mul_res_3 ~ $([-] $(42 sub_res_4))
  & sub_res_4 ~ top_ret_1

@result = top_ret_5
  & 48 ~ top_ret_5

@main = main_ret_6
  & @result ~ $([+0] main_ret_6)