@prim_add = (a (b ret))
  & a ~ $([+] $(b ret))

@prim_sub = (a (b ret))
  & a ~ $([-] $(b ret))

@prim_mul = (a (b ret))
  & a ~ $([*] $(b ret))

@prim_div = (a (b ret))
  & a ~ $([/] $(b ret))

@prim_rem = (a (b ret))
  & a ~ $([%] $(b ret))

@prim_eq = (a (b ret))
  & a ~ $([=] $(b ret))

@prim_neq = (a (b ret))
  & a ~ $([!] $(b ret))

@prim_lt = (a (b ret))
  & a ~ $([<] $(b ret))

@prim_gt = (a (b ret))
  & a ~ $([>] $(b ret))

@prim_lte = (a (b ret))
  & b ~ $([<] $(a lt))
  & 1 ~ $([-] $(lt ret))

@prim_gte = (a (b ret))
  & a ~ $([<] $(b lt))
  & 1 ~ $([-] $(lt ret))

@I_hash = (x x)

@div = @prim_div

