// MyNil takes (nil_case (* ret)):
// links nil_case to ret
@MyNil = ((nil ret) (* (nil ret)))

// MyCons h t takes (* (cons_case (h (t ret)))):
// links cons_case to (h (t ret))
@MyCons = (h (t (* (cons (h (t ret))))))

// fold: f acc xs
@fold = (f (acc (xs ret)))
  & xs ~ ((acc ret) (@fold_step (f (acc ret))))

@fold_step = (h (t (f (acc ret))))
  & {f1 f2} ~ f
  & f1 ~ (acc (h new_acc))
  & @fold ~ (f2 (new_acc (t ret)))

@add = (a (b ret))
  & a ~ $([+] $(b ret))

@main = ret
  & @MyCons ~ (10 (l2 l1))
  & @MyCons ~ (20 (l3 l2))
  & @MyCons ~ (12 (@MyNil l3))
  & @fold ~ (@add (0 (l1 ret)))
