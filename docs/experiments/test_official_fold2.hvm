@List/Cons = (a (b ((@List/Cons/tag (a (b c))) c)))
@List/Cons/tag = 1

@List/Nil = ((@List/Nil/tag a) a)
@List/Nil/tag = 0

@map = (a ((@map__C1 (a b)) b))

@map__C0 = (* (a (d ({(a b) c} f))))
  & @List/Cons ~ (b (e f))
  & @map ~ (c (d e))

@map__C1 = (?(((* @List/Nil) @map__C0) a) a)

@step = (x ret)
  & x ~ $([*2] $([+1] ret))

@add = (a (b ret))
  & a ~ $([+] $(b ret))

// fold: f acc xs
@fold = (f (acc ((@fold__C1 (f (acc b))) b)))

@fold__C1 = (?(((* (f (acc acc))) @fold__C0) a) a)

@fold__C0 = (* ((f (acc ret)) (h (t f_ret))))
  & {f1 f2} ~ f
  & f1 ~ (acc (h new_acc))
  & @fold ~ (f2 (new_acc (t ret)))

@main = ret
  & @List/Cons ~ (1 (l2 l1))
  & @List/Cons ~ (2 (l3 l2))
  & @List/Cons ~ (3 (l4 l3))
  & @List/Cons ~ (4 (@List/Nil l4))
  & @map ~ (@step (l1 mapped))
  & @fold ~ (@add (0 (mapped ret)))
