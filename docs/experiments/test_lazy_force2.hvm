@from = (n ret)
  & @make_thunk ~ (n (@thunk_from ret))

@thunk_from = (env ret)
  & $([+1] next_n) ~ env
  & @from ~ (next_n ret)

@make_thunk = (env (demand thunk))
  & thunk ~ ((demand (env ret)) ret)

@force = (((demand (env ret)) ret) res)
  & demand ~ (env res)

// Main: force twice
@main = res
  & @from ~ (1 thunk1)
  & @force ~ (thunk1 thunk2)
  & @force ~ (thunk2 res)
