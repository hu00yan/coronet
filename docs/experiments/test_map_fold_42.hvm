@MyNil = (nil (* nil))
@MyCons = (h (t (* ((h (t call)) call))))

@myMap = (f (xs ret))
  & xs ~ (@map_nil (@map_step (f ret)))

@map_nil = (* @MyNil)

@map_step = (h (t (f ret)))
  & {f1 f2} ~ f
  & f1 ~ (h fh)
  & @myMap ~ (f2 (t ft))
  & @MyCons ~ (fh (ft ret))

@myFold = (f (acc (xs ret)))
  & xs ~ (@fold_nil (@fold_step (f (acc ret))))

@fold_nil = (* (acc acc))

@fold_step = (h (t (f (acc ret))))
  & {f1 f2} ~ f
  & f1 ~ (acc (h new_acc))
  & @myFold ~ (f2 (new_acc (t ret)))

@add = (a (b ret))
  & a ~ $([+] $(b ret))

@step = (x ret)
  & x ~ $([*2] $([+1] ret))

@main = ret
  & @MyCons ~ (1 (l2 l1))
  & @MyCons ~ (2 (l3 l2))
  & @MyCons ~ (3 (l4 l3))
  & @MyCons ~ (4 (@MyNil l4))
  & @myMap ~ (@step (l1 mapped))
  & @myFold ~ (@add (0 (mapped ret)))
