@merge = (λ&xs (λ&ys ( ! &wild = xs; ((wild ys) (λ&x (λ&xs_ ( ! &wild1 = ys; ((wild1 wild) (λ&y (λ&ys_ ( ! &x1 = x; ( ! &wild2 = x1; ( ! &y1 = y; ( ! &wild3 = y1; (~ (<= x1 y1) { 0: ((@Cons wild3) ((@merge wild) ys_)) 1+p: ((@Cons wild2) ((@merge xs_) wild1)) }) ) ) ) )))) )))) )))
@lvl = ((@Pair @Nil) @Nil)
@splitAtL = (λ&n (λ&xs ( ! &x = n; (~ (<= x 0) { 0: ((xs @lvl) (λ&y (λ&ys (((@splitAtL (- x 1)) ys) (λ&l (λ&r ((@Pair ((@Cons y) l)) r))))))) 1+p: ((@Pair @Nil) xs) }) )))
@lvl1 = 0
@lengthL = (λ&xs ((xs @lvl1) (λ&ds (λ&rest ( ! &y = (@lengthL rest); (+ 1 y) )))))
@checksum = (λ&xs ((xs @lvl1) (λ&y (λ&ys ( ! &x = y; ( ! &y1 = (@checksum ys); (+ x (* 3 y1)) ) )))))
@div2 = (λ&n ( ! &x = n; (~ (<= x 1) { 0: ( ! &y = (@div2 (- x 2)); (+ 1 y) ) 1+p: @lvl1 }) ))
@mergesort = (λ&xs ( ! &wild = xs; ((wild @Nil) (λ&x (λ&ds ((ds wild) (λ&ipv (λ&ipv1 (((@splitAtL (@div2 (@lengthL wild))) wild) (λ&left (λ&right ((@merge (@mergesort left)) (@mergesort right))))))))))) ))
