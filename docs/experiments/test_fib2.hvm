// fib n
// If n == 0: 0
// If n == 1: 1
// If n >= 2: fib(n-1) + fib(n-2)

@fib = (?((0 @fib_pos) call) call)

@fib_pos = (?((1 @fib_rec) call) call)

@fib_rec = ({p1 p2} ret)
  & p1 ~ $([+1] n_minus_1)
  & @fib ~ (n_minus_1 r1)
  & @fib ~ (p2 r2)
  & r1 ~ $([+] $(r2 ret))

@main = ret
  & @fib ~ (10 ret)
