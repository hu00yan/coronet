// Scott Stream: only 1 constructor: Cons x xs
// Cons = (x (xs (cons_branch ret))) & cons_branch ~ (x (xs ret))
@Cons = (x (xs (cons_branch ret)))
  & cons_branch ~ (x (xs ret))

// Scott List: Nil (0), LCons (1)
@Nil = (nil (* nil))
@LCons = (x (xs (* (cons_branch ret))))
  & cons_branch ~ (x (xs ret))

// from n = Cons n (thunk_from (n + 1))
// thunk_from n branches = & @from ~ (n res) & res ~ branches
@thunk_from = (n branches)
  & @from ~ (n res)
  & res ~ branches

@from = (n ret)
  & $([+1] next_n) ~ n
  & @Cons ~ (n (({next_n} @thunk_from) ret))

// takeStream n s
// If n <= 0: Nil
// If n > 0: case s of Cons x xs -> LCons x (takeStream (n-1) xs)

@take_zero = (s ret)
  & s ~ *
  & @Nil ~ ret

@take_succ = (p (s ret))
  & s ~ (@take_cons (p ret))

@take_cons = (x (xs (p ret)))
  & @takeStream ~ (p (xs rest))
  & @LCons ~ (x (rest ret))

@takeStream = (n (s ret))
  & n ~ ?((@take_zero @take_succ) (s ret))

// sumList xs
@sum_nil = (* (acc ret))
  & acc ~ ret

@sum_cons = (x (xs (acc ret)))
  & $([+] $(x new_acc)) ~ acc
  & @sumList ~ (xs (new_acc ret))

@sumList = (xs (acc ret))
  & xs ~ ((@sum_nil @sum_cons) (acc ret))

// main: sumList (takeStream 10 (from 1)) = 55
@main = ret
  & @from ~ (1 s)
  & @takeStream ~ (10 (s taken))
  & @sumList ~ (taken (0 ret))
