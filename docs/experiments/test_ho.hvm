// MyNil and MyCons (Scott encoded)
@MyNil = (nil (* nil))
@MyCons = (h (t (* (cons ret))))
  & cons ~ (h (t ret))

// myMap f xs
// xs MyNil (\y \ys -> MyCons (f1 y) (myMap f2 ys))
@myMap = ({f1 f2} (xs ret))
  & xs ~ (@MyNil (@myMap_cons (f1 (f2 ret))))

@myMap_cons = (y (ys (f1 (f2 ret))))
  & f1 ~ (y fy)
  & @myMap ~ (f2 (ys new_ys))
  & @MyCons ~ (fy (new_ys ret))

// myFold f acc xs
// xs acc (\y \ys -> myFold f2 (f1 acc y) ys)
@myFold = ({f1 f2} (acc (xs ret)))
  & xs ~ (acc (@myFold_cons (f1 (f2 ret))))

@myFold_cons = (y (ys (f1 (f2 (acc ret)))))
  & f1 ~ (acc (y new_acc))
  & @myFold ~ (f2 (new_acc (ys ret)))

// add function
@add = (a (b ret))
  & a ~ $([+] $(b ret))

// f x = 2 * x + 1
@step = (x ret)
  & x ~ $([*2] $([+1] ret))

@main = ret
  & @MyCons ~ (1 (l2 l1))
  & @MyCons ~ (2 (l3 l2))
  & @MyCons ~ (3 (l4 l3))
  & @MyCons ~ (4 (@MyNil l4))
  & @myMap ~ (@step (l1 mapped))
  & @myFold ~ (@add (0 (mapped ret)))
