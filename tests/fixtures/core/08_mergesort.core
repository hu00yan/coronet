Rec {
merge
  = \ xs ys ->
      case xs of wild {
        Nil -> ys;
        Cons x xs' ->
          case ys of wild1 {
            Nil -> wild;
            Cons y ys' ->
              case x of wild2 { I# x1 ->
              case y of wild3 { I# y1 ->
              case <=# x1 y1 of {
                __DEFAULT -> Cons wild3 (merge wild ys');
                1# -> Cons wild2 (merge xs' wild1)
              }
              }
              }
          }
      }
end Rec }

lvl =  Pair Nil Nil

Rec {
splitAtL
  = \ n xs ->
      case n of { I# x ->
      case <=# x 0# of {
        __DEFAULT ->
          case xs of {
            Nil -> lvl;
            Cons y ys ->
              case splitAtL (I# (-# x 1#)) ys of { Pair l r ->
              Pair (Cons y l) r
              }
          };
        1# -> Pair Nil xs
      }
      }
end Rec }

lvl1 = I# 0#

Rec {
lengthL
  = \ xs ->
      case xs of {
        Nil -> lvl1;
        Cons ds rest -> case lengthL rest of { I# y -> I# (+# 1# y) }
      }
end Rec }

Rec {
checksum
  = \ xs ->
      case xs of {
        Nil -> lvl1;
        Cons y ys ->
          case y of { I# x ->
          case checksum ys of { I# y1 -> I# (+# x (*# 3# y1)) }
          }
      }
end Rec }

Rec {
div2
  = \ n ->
      case n of { I# x ->
      case <=# x 1# of {
        __DEFAULT -> case div2 (I# (-# x 2#)) of { I# y -> I# (+# 1# y) };
        1# -> lvl1
      }
      }
end Rec }

Rec {
mergesort
  = \ xs ->
      case xs of wild {
        Nil -> Nil;
        Cons x ds ->
          case ds of {
            Nil -> wild;
            Cons ipv ipv1 ->
              case splitAtL (div2 (lengthL wild)) wild of { Pair left right ->
              merge (mergesort left) (mergesort right)
              }
          }
      }
end Rec }

result1 = mergesort testList

result = checksum result1

main = result
