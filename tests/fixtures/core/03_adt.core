safeHead
  = \ xs ->
      case xs of {
        MyNil -> MyNothing;
        MyCons h ds -> MyJust h
      }

fromMaybe
  = \ def m ->
      case m of {
        MyNothing -> def;
        MyJust x -> x
      }

isNil
  = \ xs ->
      case xs of {
        MyNil -> MyTrue;
        MyCons ds ds1 -> MyFalse
      }

process1 = I# 0#

process
  = \ xs ->
      case xs of {
        MyNil -> process1;
        MyCons ds ds1 -> ds
      }

result = I# 42#

