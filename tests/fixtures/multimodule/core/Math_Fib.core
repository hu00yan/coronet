Rec {
Math_Fib_$wfib
  = \ ww_sWd ->
      case <=# ww_sWd 1# of lwild_sW8 {
        __DEFAULT -> case $wfib (-# ww_sWd 1#) of ww_sWi {
        __DEFAULT -> case $wfib (-# ww_sWd 2#) of ww_X1 {
        __DEFAULT -> +# ww_sWi ww_X1
      }
      };
        1# -> ww_sWd
      };
end Rec }

$wfib = Math_Fib_$wfib

Math_Fib_fib
  = \ n_sWb ->
      case n_sWb of {
        I# ww_sWd -> case $wfib ww_sWd of ww_sWi {
        __DEFAULT -> I# ww_sWi
      }
      }

fib = Math_Fib_fib
