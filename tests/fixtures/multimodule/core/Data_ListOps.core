Rec {
Data_ListOps_myMap
  = \ f_aXP xs_aXQ ->
      case xs_aXQ of {
        Nil -> Nil;
        Cons y_aXR ys_aXS -> Cons (f_aXP y_aXR) (myMap f_aXP ys_aXS)
      };
end Rec }

myMap = Data_ListOps_myMap

Rec {
Data_ListOps_$wmySum
  = \ xs_s104 ->
      case xs_s104 of {
        Nil -> 0#;
        Cons y_aXU ys_aXV -> case y_aXU of {
        I# x_aVK -> case $wmySum ys_aXV of ww_s108 {
        __DEFAULT -> +# x_aVK ww_s108
      }
      }
      };
end Rec }

$wmySum = Data_ListOps_$wmySum

Data_ListOps_mySum
  = \ xs_s104 ->
      case $wmySum xs_s104 of ww_s108 {
        __DEFAULT -> I# ww_s108
      }

mySum = Data_ListOps_mySum
