      }
      } in case ds_d1MF of ds_X3 {
        __DEFAULT -> case vnorm (Vec3 (case hit_s2MH of wild_a1P1 {
        I# x_a1P2 -> I# (-# x_a1P2 400#)
      }) (case hit_s2MI of wild_a1P1 {
        I# x_a1P2 -> I# (-# x_a1P2 -200#)
      }) (case hit_s2MJ of wild_a1P1 {
        I# x_a1P2 -> I# (-# x_a1P2 -800#)
      })) of wild_X1H {
        Vec3 x1_aH9 y1_aHa z1_aHb -> $j x1_aH9 y1_aHa z1_aHb
      };
        0# -> case vnorm (Vec3 hit_s2MH hit_s2MI (case hit_s2MJ of wild_a1P1 {
        I# x_a1P2 -> I# (-# x_a1P2 -1000#)
      })) of wild_X1H {
        Vec3 x1_aH9 y1_aHa z1_aHb -> $j x1_aH9 y1_aHa z1_aHb
      };
        1# -> case vnorm (Vec3 (case hit_s2MH of wild_a1P1 {
        I# x_a1P2 -> I# (-# x_a1P2 -400#)
      }) (case hit_s2MI of wild_a1P1 {
        I# x_a1P2 -> I# (-# x_a1P2 200#)
      }) (case hit_s2MJ of wild_a1P1 {
        I# x_a1P2 -> I# (-# x_a1P2 -1200#)
      })) of wild_X1H {
        Vec3 x1_aH9 y1_aHa z1_aHb -> $j x1_aH9 y1_aHa z1_aHb
      }
      }
      }
      } in case ds_d1MF of ds_X3 {
        __DEFAULT -> $j 300#;
        0# -> $j 100#;
        1# -> $j 200#
      }
      }
      }
      }

lvl_s2KB
  = I# 20#

Rec {
$sfindClosest
  = \ sc_s2Od sc_s2Oc sc_s2Ob sc_s2Oa sc_s2O9 light_aZC ->
      case sc_s2Oa of wild_X1E {
        Nil -> case <# sc_s2Ob 0# of lwild_s2Mh {
        __DEFAULT -> shadeRay sc_s2O9 (I# sc_s2Ob) (I# sc_s2Oc) light_aZC;
        1# -> lvl_s2KB
      };
        Cons s_aZD rest_aZE -> case intersectSphere sc_s2O9 s_aZD of wild_a2M8 {
        I# x_a2M9 -> let idx_s2PV = +# sc_s2Od 1# in case ># x_a2M9 0# of lwild_s2Mj {
        __DEFAULT -> $sfindClosest idx_s2PV sc_s2Oc sc_s2Ob rest_aZE sc_s2O9 light_aZC;
        1# -> case <# x_a2M9 sc_s2Oc of lwild_s2Mi {
        __DEFAULT -> $sfindClosest idx_s2PV sc_s2Oc sc_s2Ob rest_aZE sc_s2O9 light_aZC;
        1# -> $sfindClosest idx_s2PV x_a2M9 idx_s2PV rest_aZE sc_s2O9 light_aZC
      }
      }
      }
      };
end Rec }

Rec {
$sfindClosest
  = \ sc_s2P5 sc_s2P4 sc_s2P3 sc_s2P2 curIdx_aZB light_aZC ->
      case sc_s2P3 of wild_X1E {
        Nil -> case sc_s2P4 of wild_a2LW {
        I# x_a2LX -> case <# x_a2LX 0# of lwild_s2Mh {
        __DEFAULT -> shadeRay sc_s2P2 wild_a2LW (I# sc_s2P5) light_aZC;
        1# -> lvl_s2KB
      }
      };
        Cons s_aZD rest_aZE -> case intersectSphere sc_s2P2 s_aZD of wild_a2M8 {
        I# x_a2M9 -> let idx_s2J7 = case curIdx_aZB of wild_a1NT {
        I# x_a1NU -> I# (+# x_a1NU 1#)
      } in case ># x_a2M9 0# of lwild_s2Mj {
        __DEFAULT -> $sfindClosest sc_s2P5 sc_s2P4 rest_aZE sc_s2P2 idx_s2J7 light_aZC;
        1# -> case <# x_a2M9 sc_s2P5 of lwild_s2Mi {
        __DEFAULT -> $sfindClosest sc_s2P5 sc_s2P4 rest_aZE sc_s2P2 idx_s2J7 light_aZC;
        1# -> $sfindClosest x_a2M9 idx_s2J7 rest_aZE sc_s2P2 idx_s2J7 light_aZC
      }
      }
      }
      };
end Rec }

Rec {
findClosest
  = \ ray_aZx spheres_aZy bestIdx_aZz bestT_aZA curIdx_aZB light_aZC ->
      case spheres_aZy of wild_X1E {
        Nil -> case bestIdx_aZz of wild_a2LW {
        I# x_a2LX -> case <# x_a2LX 0# of lwild_s2Mh {
        __DEFAULT -> shadeRay ray_aZx wild_a2LW bestT_aZA light_aZC;
        1# -> lvl_s2KB
      }
      };
        Cons s_aZD rest_aZE -> case intersectSphere ray_aZx s_aZD of wild_a2M8 {
        I# x_a2M9 -> let idx_s2J7 = case curIdx_aZB of wild_a1NT {
        I# x_a1NU -> I# (+# x_a1NU 1#)
      } in case ># x_a2M9 0# of lwild_s2Mj {
        __DEFAULT -> findClosest ray_aZx rest_aZE bestIdx_aZz bestT_aZA idx_s2J7 light_aZC;
        1# -> case bestT_aZA of wild1_a2LZ {
        I# y_a2M0 -> case <# x_a2M9 y_a2M0 of lwild_s2Mi {
        __DEFAULT -> $sfindClosest y_a2M0 bestIdx_aZz rest_aZE ray_aZx idx_s2J7 light_aZC;
        1# -> $sfindClosest x_a2M9 idx_s2J7 rest_aZE ray_aZx idx_s2J7 light_aZC
      }
      }
      }
      }
      };
end Rec }

traceRay
  = \ ray_aZu spheres_aZv light_aZw ->
      $sfindClosest -1# 999999# -1# spheres_aZv ray_aZu light_aZw

Rec {
$srenderRow
  = \ sc_s2NU sc_s2NT sc_s2NS spheres_aZW light_aZX ->
      case >=# sc_s2NT sc_s2NU of lwild_s2Mk {
        __DEFAULT -> Cons ($sfindClosest -1# 999999# -1# spheres_aZW (Ray lvl_s2Kc (vnorm (Vec3 (I# (*# (-# sc_s2NT (uncheckedIShiftRA# sc_s2NU 1#)) 50#)) (case sc_s2NS of wild_a1P1 {
        I# x_a1P2 -> I# (*# (-# x_a1P2 (uncheckedIShiftRA# sc_s2NU 1#)) 50#)
      }) sceneSpheres_s1Oh))) light_aZX) ($srenderRow sc_s2NU (+# sc_s2NT 1#) sc_s2NS spheres_aZW light_aZX);
        1# -> Nil
      };
end Rec }

Rec {
$srenderRow
  = \ sc_s2NP sc_s2NO sc_s2NN spheres_aZW light_aZX ->
      case >=# sc_s2NO sc_s2NP of lwild_s2Mk {
        __DEFAULT -> Cons ($sfindClosest -1# 999999# -1# spheres_aZW (Ray lvl_s2Kc (vnorm (Vec3 (I# (*# (-# sc_s2NO (uncheckedIShiftRA# sc_s2NP 1#)) 50#)) (I# (*# (-# sc_s2NN (uncheckedIShiftRA# sc_s2NP 1#)) 50#)) sceneSpheres_s1Oh))) light_aZX) ($srenderRow sc_s2NP (+# sc_s2NO 1#) sc_s2NN spheres_aZW light_aZX);
        1# -> Nil
      };
end Rec }

$srenderRow
  = \ sc_s2ND sc_s2NC width_aZV spheres_aZW light_aZX ->
      case width_aZV of wild1_a2Lx {
        I# y_a2Ly -> case >=# sc_s2ND y_a2Ly of lwild_s2Mk {
        __DEFAULT -> Cons ($sfindClosest -1# 999999# -1# spheres_aZW (Ray lvl_s2Kc (vnorm (Vec3 (I# (*# (-# sc_s2ND (uncheckedIShiftRA# y_a2Ly 1#)) 50#)) (I# (*# (-# sc_s2NC (uncheckedIShiftRA# y_a2Ly 1#)) 50#)) sceneSpheres_s1Oh))) light_aZX) ($srenderRow y_a2Ly (+# sc_s2ND 1#) sc_s2NC spheres_aZW light_aZX);
        1# -> Nil
      }
      }

renderRow
  = \ y_aZT x_aZU width_aZV spheres_aZW light_aZX ->
      case x_aZU of wild_a2Lu {
        I# x_a2Lv -> case width_aZV of wild1_a2Lx {
        I# y_a2Ly -> case >=# x_a2Lv y_a2Ly of lwild_s2Mk {
        __DEFAULT -> Cons ($sfindClosest -1# 999999# -1# spheres_aZW (Ray lvl_s2Kc (vnorm (Vec3 (I# (*# (-# x_a2Lv (uncheckedIShiftRA# y_a2Ly 1#)) 50#)) (case y_aZT of wild_a1P1 {
        I# x_a1P2 -> I# (*# (-# x_a1P2 (uncheckedIShiftRA# y_a2Ly 1#)) 50#)
      }) sceneSpheres_s1Oh))) light_aZX) ($srenderRow y_a2Ly (+# x_a2Lv 1#) y_aZT spheres_aZW light_aZX);
        1# -> Nil
      }
      }
      }

Rec {
$srenderGrid
  = \ sc_s2Nn sc_s2Nm width_a105 spheres_a106 light_a107 ->
      case >=# sc_s2Nm sc_s2Nn of lwild_s2Ml {
        __DEFAULT -> appendL ($srenderRow 0# sc_s2Nm width_a105 spheres_a106 light_a107) ($srenderGrid sc_s2Nn (+# sc_s2Nm 1#) width_a105 spheres_a106 light_a107);
        1# -> Nil
      };
end Rec }

renderGrid
  = \ y_a103 height_a104 width_a105 spheres_a106 light_a107 ->
      case y_a103 of wild_a2Lu {
        I# x_a2Lv -> case height_a104 of wild1_a2Lx {
        I# y_a2Ly -> case >=# x_a2Lv y_a2Ly of lwild_s2Ml {
        __DEFAULT -> appendL ($srenderRow 0# x_a2Lv width_a105 spheres_a106 light_a107) ($srenderGrid y_a2Ly (+# x_a2Lv 1#) width_a105 spheres_a106 light_a107);
        1# -> Nil
      }
      }
      }

lvl_s2MN
  = I# 16#

lvl_s2MP
  = $srenderGrid 16# 0# lvl_s2MN sceneSpheres sceneLight

result
  = checksumList lvl_s2MP

main = result
