  = I# 20#

Rec {
$sfindClosest
  = \ sc_s2N5 sc_s2N4 sc_s2N3 sc_s2N2 sc_s2N1 light_aY8 ->
      case sc_s2N2 of {
        Nil -> case <# sc_s2N3 0# of lwild_s2L9 {
        __DEFAULT -> shadeRay sc_s2N1 (I# sc_s2N3) (I# sc_s2N4) light_aY8;
        1# -> lvl_s2Jt
      };
        Cons s_aY9 rest_aYa -> case intersectSphere sc_s2N1 s_aY9 of {
        I# x_a2L1 -> let idx_s2ON = +# sc_s2N5 1# in case ># x_a2L1 0# of lwild_s2Lb {
        __DEFAULT -> $sfindClosest idx_s2ON sc_s2N4 sc_s2N3 rest_aYa sc_s2N1 light_aY8;
        1# -> case <# x_a2L1 sc_s2N4 of lwild_s2La {
        __DEFAULT -> $sfindClosest idx_s2ON sc_s2N4 sc_s2N3 rest_aYa sc_s2N1 light_aY8;
        1# -> $sfindClosest idx_s2ON x_a2L1 idx_s2ON rest_aYa sc_s2N1 light_aY8
      }
      }
      }
      };
end Rec }

Rec {
$sfindClosest
  = \ sc_s2NX sc_s2NW sc_s2NV sc_s2NU curIdx_aY7 light_aY8 ->
      case sc_s2NV of {
        Nil -> case sc_s2NW of {
        I# x_a2KP -> case <# x_a2KP 0# of lwild_s2L9 {
        __DEFAULT -> shadeRay sc_s2NU wild_a2KO (I# sc_s2NX) light_aY8;
        1# -> lvl_s2Jt
      }
      };
        Cons s_aY9 rest_aYa -> case intersectSphere sc_s2NU s_aY9 of {
        I# x_a2L1 -> let idx_s2HZ = case curIdx_aY7 of {
        I# x_a1MM -> I# (+# x_a1MM 1#)
      } in case ># x_a2L1 0# of lwild_s2Lb {
        __DEFAULT -> $sfindClosest sc_s2NX sc_s2NW rest_aYa sc_s2NU idx_s2HZ light_aY8;
        1# -> case <# x_a2L1 sc_s2NX of lwild_s2La {
        __DEFAULT -> $sfindClosest sc_s2NX sc_s2NW rest_aYa sc_s2NU idx_s2HZ light_aY8;
        1# -> $sfindClosest x_a2L1 idx_s2HZ rest_aYa sc_s2NU idx_s2HZ light_aY8
      }
      }
      }
      };
end Rec }

Rec {
findClosest
  = \ ray_aY3 spheres_aY4 bestIdx_aY5 bestT_aY6 curIdx_aY7 light_aY8 ->
      case spheres_aY4 of {
        Nil -> case bestIdx_aY5 of {
        I# x_a2KP -> case <# x_a2KP 0# of lwild_s2L9 {
        __DEFAULT -> shadeRay ray_aY3 wild_a2KO bestT_aY6 light_aY8;
        1# -> lvl_s2Jt
      }
      };
        Cons s_aY9 rest_aYa -> case intersectSphere ray_aY3 s_aY9 of {
        I# x_a2L1 -> let idx_s2HZ = case curIdx_aY7 of {
        I# x_a1MM -> I# (+# x_a1MM 1#)
      } in case ># x_a2L1 0# of lwild_s2Lb {
        __DEFAULT -> findClosest ray_aY3 rest_aYa bestIdx_aY5 bestT_aY6 idx_s2HZ light_aY8;
        1# -> case bestT_aY6 of {
        I# y_a2KS -> case <# x_a2L1 y_a2KS of lwild_s2La {
        __DEFAULT -> $sfindClosest y_a2KS bestIdx_aY5 rest_aYa ray_aY3 idx_s2HZ light_aY8;
        1# -> $sfindClosest x_a2L1 idx_s2HZ rest_aYa ray_aY3 idx_s2HZ light_aY8
      }
      }
      }
      }
      };
end Rec }

traceRay
  = \ ray_aY0 spheres_aY1 light_aY2 ->
      $sfindClosest -1# 999999# -1# spheres_aY1 ray_aY0 light_aY2

Rec {
$srenderRow
  = \ sc_s2MM sc_s2ML sc_s2MK spheres_aYs light_aYt ->
      case >=# sc_s2ML sc_s2MM of lwild_s2Lc {
        __DEFAULT -> Cons ($sfindClosest -1# 999999# -1# spheres_aYs (Ray lvl_s2J4 (vnorm (Vec3 (I# (*# (-# sc_s2ML (uncheckedIShiftRA# sc_s2MM 1#)) 50#)) (case sc_s2MK of {
        I# x_a1NU -> I# (*# (-# x_a1NU (uncheckedIShiftRA# sc_s2MM 1#)) 50#)
      }) sceneSpheres_s1N9))) light_aYt) ($srenderRow sc_s2MM (+# sc_s2ML 1#) sc_s2MK spheres_aYs light_aYt);
        1# -> Nil
      };
end Rec }

Rec {
$srenderRow
  = \ sc_s2MH sc_s2MG sc_s2MF spheres_aYs light_aYt ->
      case >=# sc_s2MG sc_s2MH of lwild_s2Lc {
        __DEFAULT -> Cons ($sfindClosest -1# 999999# -1# spheres_aYs (Ray lvl_s2J4 (vnorm (Vec3 (I# (*# (-# sc_s2MG (uncheckedIShiftRA# sc_s2MH 1#)) 50#)) (I# (*# (-# sc_s2MF (uncheckedIShiftRA# sc_s2MH 1#)) 50#)) sceneSpheres_s1N9))) light_aYt) ($srenderRow sc_s2MH (+# sc_s2MG 1#) sc_s2MF spheres_aYs light_aYt);
        1# -> Nil
      };
end Rec }

$srenderRow
  = \ sc_s2Mv sc_s2Mu width_aYr spheres_aYs light_aYt ->
      case width_aYr of {
        I# y_a2Kq -> case >=# sc_s2Mv y_a2Kq of lwild_s2Lc {
        __DEFAULT -> Cons ($sfindClosest -1# 999999# -1# spheres_aYs (Ray lvl_s2J4 (vnorm (Vec3 (I# (*# (-# sc_s2Mv (uncheckedIShiftRA# y_a2Kq 1#)) 50#)) (I# (*# (-# sc_s2Mu (uncheckedIShiftRA# y_a2Kq 1#)) 50#)) sceneSpheres_s1N9))) light_aYt) ($srenderRow y_a2Kq (+# sc_s2Mv 1#) sc_s2Mu spheres_aYs light_aYt);
        1# -> Nil
      }
      }

renderRow
  = \ y_aYp x_aYq width_aYr spheres_aYs light_aYt ->
      case x_aYq of {
        I# x_a2Kn -> case width_aYr of {
        I# y_a2Kq -> case >=# x_a2Kn y_a2Kq of lwild_s2Lc {
        __DEFAULT -> Cons ($sfindClosest -1# 999999# -1# spheres_aYs (Ray lvl_s2J4 (vnorm (Vec3 (I# (*# (-# x_a2Kn (uncheckedIShiftRA# y_a2Kq 1#)) 50#)) (case y_aYp of {
        I# x_a1NU -> I# (*# (-# x_a1NU (uncheckedIShiftRA# y_a2Kq 1#)) 50#)
      }) sceneSpheres_s1N9))) light_aYt) ($srenderRow y_a2Kq (+# x_a2Kn 1#) y_aYp spheres_aYs light_aYt);
        1# -> Nil
      }
      }
      }

Rec {
$srenderGrid
  = \ sc_s2Mf sc_s2Me width_aYB spheres_aYC light_aYD ->
      case >=# sc_s2Me sc_s2Mf of lwild_s2Ld {
        __DEFAULT -> appendL ($srenderRow 0# sc_s2Me width_aYB spheres_aYC light_aYD) ($srenderGrid sc_s2Mf (+# sc_s2Me 1#) width_aYB spheres_aYC light_aYD);
        1# -> Nil
      };
end Rec }

renderGrid
  = \ y_aYz height_aYA width_aYB spheres_aYC light_aYD ->
      case y_aYz of {
        I# x_a2Kn -> case height_aYA of {
        I# y_a2Kq -> case >=# x_a2Kn y_a2Kq of lwild_s2Ld {
        __DEFAULT -> appendL ($srenderRow 0# x_a2Kn width_aYB spheres_aYC light_aYD) ($srenderGrid y_a2Kq (+# x_a2Kn 1#) width_aYB spheres_aYC light_aYD);
        1# -> Nil
      }
      }
      }

lvl_s2LF
  = I# 16#

lvl_s2LH
  = $srenderGrid 16# 0# lvl_s2LF sceneSpheres sceneLight

result
  = checksumList lvl_s2LH

main = result
