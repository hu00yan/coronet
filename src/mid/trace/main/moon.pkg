options(
  "allow-experimental-packages": [
    "moonbitlang/core/async",
    "moonbitlang/core/async/fs",
  ],
)

import {
  "coronet/src/syntax" @syntax,
  "coronet/src/mid" @mid,
  "coronet/src/lower_hvm2" @lower_hvm2,
  "coronet/src/lower_hvm3" @lower_hvm3,
  "moonbitlang/core/async",
  "moonbitlang/core/async/fs" @fs,
  "moonbitlang/core/bench" @bench,
  "moonbitlang/core/env" @env,
}

pkgtype(kind: "executable")
